{
  "name": "three-iso",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "gate": "bun scripts/gate.ts",
    "setup": "bun scripts/setup.ts",
    "brief": "bun scripts/brief.ts",
    "api:digest": "bun scripts/api-digest.ts",
    "scape:map": "bun scripts/scape-map.ts",
    "scape:shot": "bun scripts/scape-shot.ts",
    "scape:diff": "bun scripts/scape-diff.ts",
    "prop:map": "bun scripts/prop-map.ts",
    "prop:watch": "bun --watch scripts/prop-map.ts"
  },
  "dependencies": {
    "@tuomashatakka/canvas-loop-framecapper": "^1.0.0",
    "three": "^0.185.1",
    "threejs-scene": "^0.5.0"
  },
  "devDependencies": {
    "@tuomashatakka/eslint-config": "^4.0.1",
    "@types/bun": "^1.3.14",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.185.4",
    "eslint": "^10.8.1",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.1"
  }
}
